<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- xADKiller stores protection state, custom rules, diagnostics and VPN-related
         preferences locally. Do not export any app-private data to cloud backup or
         OEM device-to-device migration, including vendors that do not fully honor
         android:allowBackup="false" for D2D transfer on Android 12+. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
