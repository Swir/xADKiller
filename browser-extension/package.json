{
  "name": "xadkiller-browser-extension",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "build": "node --import ./tools/fetch-node-http.mjs tools/build-chrome-ultra.mjs && node --import ./tools/fetch-node-http.mjs tools/build-dynamic-intel.mjs && node --import ./tools/fetch-node-http.mjs tools/build-titan-session.mjs && node --import ./tools/fetch-node-http.mjs tools/build-titan-boost.mjs && node tools/dedupe-rule-layers.mjs && node tools/stamp-build-meta.mjs && node tools/optimize-chrome-runtime.mjs",
    "validate": "node tools/validate-chrome-ultra.mjs && node tools/validate-titan-boost.mjs && node tools/dedupe-rule-layers.mjs --check",
    "test:chrome": "node tests/chrome-ultra-runtime.mjs",
    "test:boost": "node tests/chrome-static-boost-runtime.mjs",
    "test:compat": "node tests/chrome-compat-runtime.mjs",
    "test:language": "node tests/chrome-language-runtime.mjs",
    "test:memory": "node tests/chrome-adaptive-memory-runtime.mjs",
    "test:pause": "node tests/chrome-temporary-pause-runtime.mjs",
    "test:feeds": "node tests/chrome-feed-guard-runtime.mjs && node tests/chrome-feed-offline-fallback.mjs",
    "test:feed-v2-consumers": "node tests/feed-v2-consumer-compat.mjs",
    "test:feed-v2-migration": "node tools/feed-v2-migration-preflight.mjs",
    "test:feed-v2-artifacts": "node tools/validate-feed-v2-candidate-artifacts.mjs",
    "test:feed-checksums": "node tools/validate-feed-checksums.mjs",
    "test:layer-dedupe": "node tools/dedupe-rule-layers.mjs --check",
    "test:rule-ranking": "node tests/rule-quality-ranking.mjs",
    "test:benchmark": "node tests/chrome-blocking-benchmark.mjs",
    "test:shadow-soak": "node tests/chrome-shadow-mutation-soak.mjs",
    "test:real-page": "node tests/chrome-real-page-soak.mjs",
    "test:performance": "node tests/chrome-performance-budget.mjs",
    "build:feed-v2-candidates": "node tools/feed-v2-migration-preflight.mjs --write",
    "build:legacy": "node tools/build.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "puppeteer-core": "25.6.0",
    "web-ext": "10.6.0"
  }
}
